datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ASSET_MANAGER
  EMPLOYEE
}

enum AssetStatus {
  AVAILABLE
  ALLOCATED
  RESERVED
  UNDER_MAINTENANCE
  LOST
  RETIRED
  DISPOSED
}

model User {
  id                  String            @id @default(uuid())
  email               String            @unique
  username            String            @unique
  password            String
  name                String
  role                Role              @default(EMPLOYEE)
  departmentId        String?
  department          Department?       @relation("UserDept", fields: [departmentId], references: [id])
  managedDepartments  Department[]      @relation("DeptManager")
  roleChanges         RoleChangeLog[]   @relation("RoleChangeUser")
  executedRoleChanges RoleChangeLog[]   @relation("RoleChangeExecutor")
  assetHistory        AssetHistory[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Department {
  id        String       @id @default(uuid())
  name      String       @unique
  isActive  Boolean      @default(true)
  parentId  String?
  parent    Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")
  managerId String?
  manager   User?        @relation("DeptManager", fields: [managerId], references: [id])
  users     User[]       @relation("UserDept")
  assets    Asset[]
}

model Category {
  id             String   @id @default(uuid())
  name           String   @unique
  isActive       Boolean  @default(true)
  warrantyPeriod Int?     // In months
  assets         Asset[]
}

model RoleChangeLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("RoleChangeUser", fields: [userId], references: [id])
  oldRole     Role
  newRole     Role
  changedById String
  changedBy   User     @relation("RoleChangeExecutor", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())
}

model Asset {
  id           String         @id @default(uuid())
  assetTag     String         @unique
  name         String
  serialNumber String         @unique
  status       AssetStatus    @default(AVAILABLE)
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  location     String
  purchaseDate DateTime?
  cost         Float?
  notes        String?
  history      AssetHistory[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AssetHistory {
  id          String       @id @default(uuid())
  assetId     String
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action      String       // e.g. "REGISTER", "STATUS_CHANGE", "UPDATE"
  oldStatus   AssetStatus?
  newStatus   AssetStatus
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  notes       String?
  createdAt   DateTime     @default(now())
}
